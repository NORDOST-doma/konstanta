# Настройки сервера УК «Константа»
PORT=3000

# Настройки SMTP почты для отправки заявок
# Для Яндекс: smtp.yandex.ru, порт 465, secure=true
# Для Mail.ru: smtp.mail.ru, порт 465, secure=true
# Для Gmail: smtp.gmail.com, порт 465, secure=true
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@konstanta.ru
SMTP_PASS=your_app_password

# Адрес получателя уведомлений о заявках
EMAIL_TO=info@konstanta.ru
